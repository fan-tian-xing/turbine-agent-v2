{
  "version": "10",
  "namespace": "https://turbine.local/ontology#",
  "classes": [
    {
      "id": "PhysicalObject",
      "zh": "物理对象",
      "parent": "Thing",
      "definition": "具有物质组成、可作为安装或检查对象的实体。",
      "aliases": [],
      "extractable": true
    },
    {
      "id": "Equipment",
      "zh": "设备",
      "parent": "PhysicalObject",
      "definition": "为实现工程功能而设计的物理对象。",
      "aliases": [],
      "extractable": true
    },
    {
      "id": "Component",
      "zh": "部件",
      "parent": "PhysicalObject",
      "definition": "构成设备或系统的结构或功能单元；具体所属整体由组成关系表达。",
      "aliases": [],
      "extractable": true
    },
    {
      "id": "System",
      "zh": "工程系统",
      "parent": "PhysicalObject",
      "definition": "由相互作用的物理对象组成、共同实现工程功能的整体。",
      "aliases": [],
      "extractable": true
    },
    {
      "id": "Tool",
      "zh": "工具",
      "parent": "PhysicalObject",
      "definition": "用于辅助安装、检查或操作的物理对象。",
      "aliases": [],
      "extractable": true
    },
    {
      "id": "Activity",
      "zh": "活动",
      "parent": "Thing",
      "definition": "由参与对象在一定时间内进行的操作或过程。",
      "aliases": [],
      "extractable": true
    }
  ],
  "record_types": [
    {
      "id": "Mention",
      "zh": "来源提及",
      "definition": "原文对对象或活动的名称提及；只内嵌保存于知识记录，不代表实际实例或独立检索节点。",
      "aliases": [],
      "extractable": true
    },
    {
      "id": "OntologyClass",
      "zh": "类存储代理",
      "definition": "对应已审定本体类的图存储表示；不是领域业务类或现场实例。",
      "aliases": [],
      "extractable": false
    },
    {
      "id": "Statement",
      "zh": "知识记录",
      "definition": "表达一项有来源的要求、作业、检查、状态、原因或措施的记录。",
      "aliases": [],
      "extractable": false
    },
    {
      "id": "Evidence",
      "zh": "来源证据",
      "definition": "按可独立理解与引用的上下文组装的资料原文及其来源定位。",
      "aliases": [],
      "extractable": false
    },
    {
      "id": "TechnicalDocument",
      "zh": "资料记录",
      "definition": "书籍或规范的版本及来源标识记录。",
      "aliases": [],
      "extractable": false
    }
  ],
  "domain_classes": [
    {
      "id": "HeatExchanger",
      "label": "热交换器",
      "parent": "Equipment",
      "definition": "在不同温度的介质之间传递热量的设备。",
      "aliases": [],
      "scope_note": "包含通过壁面传热或介质直接接触传热的设备。",
      "definition_sources": [
        "https://www.gevernova.com/gas-power/products/heat-exchangers"
      ]
    },
    {
      "id": "SurfaceHeatExchanger",
      "label": "表面式热交换器",
      "parent": "HeatExchanger",
      "definition": "通过固体传热壁面在相互隔离的介质之间传递热量的热交换器。",
      "aliases": []
    },
    {
      "id": "Condenser",
      "label": "凝汽器",
      "parent": "HeatExchanger",
      "definition": "通过移除汽轮机排汽的热量，使蒸汽凝结为液态水的热交换设备。",
      "aliases": [],
      "definition_sources": [
        "https://www.gevernova.com/gas-power/products/heat-exchangers"
      ]
    },
    {
      "id": "Heater",
      "label": "加热器",
      "parent": "Equipment",
      "definition": "向介质或对象提供热量以提高其温度的设备。",
      "aliases": [],
      "scope_note": "本类采用广义加热设备含义，不限定热源或加热原理。"
    },
    {
      "id": "HighPressureHeater",
      "label": "高压加热器",
      "parent": "Heater",
      "definition": "布置于回热系统高压给水段、利用蒸汽加热给水的加热器。",
      "aliases": [],
      "definition_sources": [
        "https://www.gevernova.com/content/dam/gepower-steam/global/en_US/documents/Steam-Product-Catalog.pdf"
      ],
      "additional_parents": [
        "HeatExchanger"
      ]
    },
    {
      "id": "LowPressureHeater",
      "label": "低压加热器",
      "parent": "Heater",
      "definition": "布置于回热系统低压凝结水段、利用蒸汽加热凝结水的加热器。",
      "aliases": [],
      "definition_sources": [
        "https://www.gevernova.com/content/dam/gepower-steam/global/en_US/documents/Steam-Product-Catalog.pdf"
      ],
      "additional_parents": [
        "HeatExchanger"
      ]
    },
    {
      "id": "Deaerator",
      "label": "除氧器",
      "parent": "Equipment",
      "definition": "用于去除水中溶解氧及其他溶解气体的设备。",
      "aliases": [],
      "definition_sources": [
        "https://www.spiraxsarco.com/learn-about-steam/the-boiler-house/pressurised-deaerators"
      ]
    },
    {
      "id": "Ejector",
      "label": "抽气器",
      "parent": "Equipment",
      "definition": "利用工作流体射流卷吸并排出气体或蒸汽的抽气设备。",
      "aliases": []
    },
    {
      "id": "SteamJetEjector",
      "label": "射汽抽气器",
      "parent": "Ejector",
      "definition": "以蒸汽为工作介质，利用高速蒸汽射流卷吸并排出气体或蒸汽的抽气器。",
      "aliases": [],
      "definition_sources": [
        "https://www.s-k.com/steam-jet-vacuum/single-stage-steam-jet-ejectors/"
      ]
    },
    {
      "id": "WaterJetEjector",
      "label": "射水抽气器",
      "parent": "Ejector",
      "definition": "以压力水为工作介质，利用高速水射流卷吸并排出气体或蒸汽的抽气器。",
      "aliases": [],
      "definition_sources": [
        "https://www.s-k.com/exhausters-compressors/single-nozzle-water-jet-exhausters/"
      ]
    },
    {
      "id": "WaterJetPump",
      "label": "射水泵",
      "parent": "Equipment",
      "definition": "向射水抽气器供给有压工作水的泵。",
      "aliases": [],
      "scope_note": "名称指射水抽气系统的供水泵，与利用水射流抽气的射水抽气器区分。"
    },
    {
      "id": "Tank",
      "label": "箱罐",
      "parent": "Equipment",
      "definition": "用于容纳、储存或缓冲介质的箱形或罐形设备。",
      "aliases": []
    },
    {
      "id": "WaterTank",
      "label": "水箱",
      "parent": "Tank",
      "definition": "用于容纳水的箱罐。",
      "aliases": []
    },
    {
      "id": "PressureVessel",
      "label": "压力容器",
      "parent": "Equipment",
      "definition": "用于容纳承压介质的封闭容器。",
      "aliases": []
    },
    {
      "id": "DesuperheatingPressureReducingDevice",
      "label": "减温减压装置",
      "parent": "Equipment",
      "definition": "将蒸汽温度和压力降低至所需工况的设备。",
      "aliases": [
        "减温减压器"
      ]
    },
    {
      "id": "AirCoolingDevice",
      "label": "空冷装置",
      "parent": "System",
      "definition": "以空气为最终冷却介质，通过换热设备及辅助设施排出热量的工程系统。",
      "aliases": []
    },
    {
      "id": "VacuumSystem",
      "label": "真空系统",
      "parent": "System",
      "definition": "由抽气设备、连接管路及辅助对象组成，用于建立或维持低于大气压力工况的工程系统。",
      "aliases": []
    },
    {
      "id": "Nozzle",
      "label": "喷嘴",
      "parent": "Component",
      "definition": "用于形成、加速或定向输送流体射流的流道部件。",
      "aliases": [],
      "scope_note": "此处指形成流体射流的喷嘴，不将工艺设备的接管接口自动视为同义词。"
    },
    {
      "id": "Diffuser",
      "label": "扩散管",
      "parent": "Component",
      "definition": "通过流道扩展使流体减速并回收静压的部件。",
      "aliases": []
    },
    {
      "id": "PipeCompensator",
      "label": "管道补偿器",
      "parent": "Component",
      "definition": "装入管路、用于补偿管道位移或变形的部件。",
      "aliases": []
    },
    {
      "id": "Installation",
      "label": "安装",
      "parent": "Activity",
      "definition": "将设备或部件就位、连接并形成预定装配状态的活动。",
      "aliases": []
    },
    {
      "id": "Inspection",
      "label": "检查",
      "parent": "Activity",
      "definition": "通过观察、测量或核查评价对象状态及符合性的活动。",
      "aliases": []
    },
    {
      "id": "TestActivity",
      "label": "试验",
      "parent": "Activity",
      "definition": "在规定条件下施加作用或开展测量，以确定对象性能、状态或符合性的活动。",
      "aliases": []
    },
    {
      "id": "HydrostaticTest",
      "label": "水压试验",
      "parent": "TestActivity",
      "definition": "以水为试验介质施加压力，检验对象性能或状态的试验。",
      "aliases": []
    },
    {
      "id": "HydrostaticTightnessTest",
      "label": "严密性水压试验",
      "parent": "HydrostaticTest",
      "definition": "以水为试验介质施加压力，检验对象严密性的试验。",
      "aliases": []
    },
    {
      "id": "TrialOperation",
      "label": "试运行",
      "parent": "Activity",
      "definition": "在正式运行前通过运行设备或系统检查其功能和运行状态的活动。",
      "aliases": []
    },
    {
      "id": "Shell",
      "label": "壳体",
      "parent": "Component",
      "definition": "构成设备外部边界、容纳或支承内部结构的部件。",
      "aliases": []
    },
    {
      "id": "CoolingTube",
      "label": "冷却管",
      "parent": "Component",
      "definition": "供冷却介质流动并参与换热的管状部件。",
      "aliases": []
    },
    {
      "id": "TubeSheet",
      "label": "管板",
      "parent": "Component",
      "definition": "开设管孔并用于定位或连接换热管的板状部件。",
      "aliases": []
    },
    {
      "id": "SupportSpring",
      "label": "支持弹簧",
      "parent": "Component",
      "definition": "用于支承载荷并允许弹性位移的弹簧部件。",
      "aliases": [
        "支撑弹簧"
      ]
    },
    {
      "id": "TubeBundle",
      "label": "管束",
      "parent": "Component",
      "definition": "由多根管按规定布局组成的部件组合。",
      "aliases": []
    },
    {
      "id": "Assembly",
      "label": "组装",
      "parent": "Activity",
      "definition": "将部件按规定位置组合并连接为整体的活动。",
      "aliases": [
        "装配"
      ]
    },
    {
      "id": "TubeInsertion",
      "label": "穿管",
      "parent": "Activity",
      "definition": "将管材穿入相应孔或支承结构的作业。",
      "aliases": [
        "穿装"
      ]
    },
    {
      "id": "TubeExpansion",
      "label": "胀接",
      "parent": "Activity",
      "definition": "通过管端塑性扩张形成连接的作业。",
      "aliases": []
    },
    {
      "id": "Welding",
      "label": "焊接",
      "parent": "Activity",
      "definition": "通过焊接方法使材料形成连接或堆敷的作业。",
      "aliases": []
    }
  ],
