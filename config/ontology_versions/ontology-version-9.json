      "aliases": [],
      "definition_sources": [
        "https://www.gevernova.com/gas-power/products/heat-exchangers"
      ]
    },
    {
      "id": "HeatExchanger",
      "label": "热交换器",
      "parent": "Equipment",
      "definition": "在不同温度的介质之间传递热量的设备。",
      "aliases": [],
      "scope_note": "包含通过壁面传热或介质直接接触传热的设备。",
      "definition_sources": [
        "https://www.gevernova.com/gas-power/products/heat-exchangers"
      ]
    },
    {
      "id": "SurfaceHeatExchanger",
      "label": "表面式热交换器",
      "parent": "HeatExchanger",
      "definition": "通过固体传热壁面在相互隔离的介质之间传递热量的热交换器。",
      "aliases": []
    },
    {
      "id": "Heater",
      "label": "加热器",
      "parent": "Equipment",
      "definition": "向介质或对象提供热量以提高其温度的设备。",
      "aliases": [],
      "scope_note": "本类采用广义加热设备含义，不限定热源或加热原理。"
    },
    {
      "id": "SelfPressureSealedHeater",
      "label": "自压密封式加热器",
      "parent": "Heater",
      "definition": "利用内部工作压力增强密封作用的加热器。",
      "aliases": []
    },
    {
      "id": "HighPressureHeater",
      "label": "高压加热器",
      "parent": "Heater",
      "definition": "布置于回热系统高压给水段、利用蒸汽加热给水的加热器。",
      "aliases": [],
      "definition_sources": [
        "https://www.gevernova.com/content/dam/gepower-steam/global/en_US/documents/Steam-Product-Catalog.pdf"
      ],
      "additional_parents": [
        "HeatExchanger"
      ]
    },
    {
      "id": "LowPressureHeater",
      "label": "低压加热器",
      "parent": "Heater",
      "definition": "布置于回热系统低压凝结水段、利用蒸汽加热凝结水的加热器。",
      "aliases": [],
      "definition_sources": [
        "https://www.gevernova.com/content/dam/gepower-steam/global/en_US/documents/Steam-Product-Catalog.pdf"
      ],
      "additional_parents": [
        "HeatExchanger"
      ]
    },
    {
      "id": "AirCoolingDevice",
      "label": "空冷装置",
      "parent": "System",
      "definition": "以空气为最终冷却介质，通过换热设备及辅助设施排出热量的工程系统。",
      "aliases": []
    },
    {
      "id": "DirectAirCoolingDevice",
      "label": "直接空冷装置",
      "parent": "AirCoolingDevice",
      "definition": "将汽轮机排汽送入空气冷却的换热管束内凝结、不以循环冷却水作为中间传热介质的空冷系统。",
      "aliases": [],
      "definition_sources": [
        "https://enexio.com/dry-cooling-systems/"
      ]
    },
    {
      "id": "IndirectAirCoolingDevice",
      "label": "间接空冷装置",
