{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turbine-agent-v2.local/schema/source-documents.json",
  "title": "Source Registry logical-document record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_logical_id",
    "revision_ids",
    "asset_ids",
    "canonical_asset_id",
    "title_candidates",
    "source_roles",
    "document_status",
    "identity_status",
    "completeness_status",
    "applicability_status",
    "applicability_scope",
    "text_adapter_status",
    "authority_level",
    "normative_modality",
    "project_adoption_status",
    "manufacturer_approval_status",
    "validity_status",
    "supersedes",
    "supersedes_status",
    "exception_basis",
    "exception_basis_status",
    "open_review_count",
    "member_relation_flags"
  ],
  "properties": {
    "document_logical_id": {"type": "string", "pattern": "^doc-[0-9a-f]{20}$"},
    "revision_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^rev-[0-9a-f]{20}$"}},
    "asset_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^asset-[0-9a-f]{20}$"}},
    "canonical_asset_id": {"type": "string", "pattern": "^asset-[0-9a-f]{20}$"},
    "title_candidates": {"type": "array", "items": {"type": "string"}},
    "source_roles": {"type": "array", "items": {"type": "string"}},
    "document_status": {"enum": ["admitted", "quarantined", "metadata_review_required", "duplicate_or_derivative", "reference_only"]},
    "identity_status": {"enum": ["review_required", "confirmed"]},
    "completeness_status": {"enum": ["review_required", "complete", "incomplete"]},
    "applicability_status": {"enum": ["review_required", "confirmed"]},
    "applicability_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "text_adapter_status": {"enum": ["not_assessed", "native_text_available", "ocr_required", "ocr_pending_validation", "ocr_validated", "text_review_required", "mixed"]},
    "authority_level": {"enum": ["regulatory", "national_standard", "industry_standard", "manufacturer", "project_document", "textbook", "reference", "unknown", "mixed"]},
    "normative_modality": {"enum": ["mandatory", "should", "recommended", "permitted", "prohibited", "informational", "mixed", "not_applicable", "unknown"]},
    "project_adoption_status": {"enum": ["adopted", "not_adopted", "candidate", "not_applicable", "unknown", "mixed"]},
    "manufacturer_approval_status": {"enum": ["approved", "not_approved", "not_applicable", "unknown", "mixed"]},
    "validity_status": {"enum": ["current", "superseded", "expired", "draft", "unknown", "mixed"]},
    "supersedes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "supersedes_status": {"enum": ["identified", "confirmed_none", "review_required", "unknown"]},
    "exception_basis": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "exception_basis_status": {"enum": ["identified", "confirmed_none", "review_required", "unknown"]},
    "open_review_count": {"type": "integer", "minimum": 0},
    "member_relation_flags": {"type": "array", "items": {"type": "string"}}
  }
}
