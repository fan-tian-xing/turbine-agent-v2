  "extraction_rules": [
    "实体角色表示本条知识中对象的作用，不用于生成实体身份。",
    "书籍中的通用对象和活动名称使用Mention，能确定种类时提供ontology_class_id；只保存来源提及，绝不据此创建现场设备或实际活动。",
    "真实物理对象或已发生活动使用相应业务类，必须有来源明确的occurrence身份。",
    "对象、活动分开表示。以设备名称、具体位置或当前工况修饰的活动不另建组合类；适用对象与活动通过同一Statement表达。",
    "semantic_relations可用当前实体的source_entity/target_entity索引；跨记录用source_ref/target_ref:{statement_id,entity_index}，省略entity_index表示该Statement，并提供关系独立supports。",
    "类层次由本体审定；组成、步骤归属和步骤先后必须有原文支持，不由同节出现或编号顺序推断。",
    "text忠实保留应、宜、不得及否定原意，不另抽modality、negation、possibility。",
    "未映射名称保留在Statement和Evidence中，不创建临时术语节点。",
    "既有别名只用于对应同一已审定类，不把更具体对象直接当作宽泛类的同义词。",
    "每条可回答Evidence须至少一条Statement，多项独立要求分别表示；标题和上下文附于Evidence。",
    "资料版本、页码、条款及引用文字由Evidence提供；章节处理范围由导入配置管理，不限制本体类的业务适用范围。"
  ],
  "storage_policy": {
    "unreviewed_terms": "statement_only",
    "mention_storage": "embedded_statement_only",
    "standalone_modality_fields": false,
    "class_hierarchy_root": "Thing",
    "statement_identity": "document_semantics_and_original_source_anchors",
    "retrieval_projection": "embedded_in_evidence",
    "statement_core_mapping": "statement_core保存原始语义与Mention；ontology_mapping单独保存当前本体映射，映射可重算",
    "statement_text_policy": "条件、数值和公式只保留在Statement.text与Evidence原文中，不拆分为独立字段。"
  }
