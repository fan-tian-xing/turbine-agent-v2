        "urn:standard:DLT5190.3:2019:clause:5.2.3"
      ]
    },
    {
      "id": "Shim",
      "label": "垫铁",
      "parent": "Component",
      "definition": "在设备安装中用于支承载荷和调整位置的垫块。",
      "aliases": [],
      "scope_note": "梯形、永久、埋置式等形状或使用状态分别保留，不与基础或底座合并。 来源：DL/T 5190.3—2019，5.1.6、5.3.4、5.1.4、5.2.9、5.3.9、5.2.12。",
