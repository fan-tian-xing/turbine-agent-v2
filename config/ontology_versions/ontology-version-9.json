  "statement_roles": [
    {
      "id": "subject",
      "zh": "主对象",
      "definition": "陈述直接提出要求、活动或状态的对象。"
    },
    {
      "id": "object",
      "zh": "作用或配合对象",
      "definition": "参与活动或配合关系的对象，不自动承接主对象的要求或量值。"
    },
    {
      "id": "related",
      "zh": "相关对象",
      "definition": "来源明确关联的对象；关联不等同于确证原因。"
    },
    {
      "id": "quantity_target",
      "zh": "量值对象",
      "definition": "参数或量值实际属于的对象，角色变化不改变实体身份。"
    }
  ],
  "statement_types": [
    "requirement",
    "parameter",
    "procedure",
    "step",
    "anomaly",
    "observation",
    "inspection",
    "cause",
    "measure",
    "verification",
    "fact",
    "limitation"
  ],
  "navigation_policy": {
    "hierarchy": "recall_expansion_only",
    "business_hop_limit": 2,
    "follow_statement_conditions": true,
    "inherit_quantities": false,
    "inherit_measures": false,
    "requires_supported_statement": true,
    "source_and_condition_edges_count_as_business_hops": false,
    "evidence_fulltext_recall": true
  },
  "extraction_rules": [
    "实体身份不包含subject/object/related/quantity_target角色，角色保留在陈述关联中。",
    "通用设备、部件和活动名称使用Concept表示来源提及；能映射已审定领域类时提供ontology_class_id并由来源核验后连接类节点。真实实例需明确身份，规范步骤不是ActualActivity。",
    "semantic_relations兼容当前陈述的source_entity/target_entity零基序号；跨陈述用source_ref/target_ref:{statement_id:批次内extraction_id,entity_index:零基序号}引用实体，省略entity_index则引用该Statement；每条跨陈述关系必须单独提供supports。",
    "没有明确来源的上下位、部件、步骤与实际活动顺序不得推断；概念part_of不得连接真实实例。",
    "类别层级与broader_concept、part_of、step_precedes、activity_precedes分别存储，不通过层级继承数值、条件或措施。",
    "要求、程序、异常、原因、措施和验证导航均经过有来源的Statement；text忠实保留应、宜、不得及否定原意，不单独抽取modality、negation、possibility字段。",
    "quantity_target必须标识来源中量值实际所属的对象；作用或配合对象的object身份不能使该量值改变归属。",
    "来源位置不等同于适用条件；缺失、不完整或无法解析的条件求值为unknown。",
    "conditions/quantities/formulas内嵌于Statement，验证时可投影临时RDF信息实体，不重复持久化附属节点。",
    "只将有明确术语或对象身份且可独立关联的实体写入entities；标点、版面编号、整句、设备列表和普通修饰不得凑成概念；重要实体不因仅出现一次被过滤。",
    "已登记别名统一名称，未登记的疑似近义词保持独立；概念关系、定义关系与实际对象关系分开。",
    "has_step只表示来源明确的程序步骤归属；step_precedes要求明确执行先后，编号顺序不能直接推断操作顺序。",
    "实体标签与陈述概括优先使用中文原文名称；text写独立完整工程事实，共享注释或范围条件不得因不同证据包装重复抽取。",
    "未审定术语保留在Statement的entities原文名称及Evidence中，不创建候选术语或临时Concept检索节点；术语清单仅用于本体建模审查。"
  ],
