# Copy this file to .env and replace the password before starting Neo4j.
SOURCE_ROOT=../Original materials
OCR_DERIVED_ROOT=var/derived/ocr
NEO4J_URI=neo4j://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password
NEO4J_DATABASE=neo4j
# Chat-completions-compatible model endpoint (base URL ending in /v1 if required).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
# Enable only for the model service permitted to receive retrieved evidence.
LLM_ALLOW_EVIDENCE_SEND=false
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_TIMEOUT_SECONDS=60
LLM_FALLBACK_2_BASE_URL=
LLM_FALLBACK_2_MODEL=
LLM_FALLBACK_2_API_KEY=
LLM_FALLBACK_2_TIMEOUT_SECONDS=60
