{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/turbine-v2/stage12-extraction-response.schema.json",
  "title": "Stage 12 structured extraction provider response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "response_kind", "status", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "response_kind": {"const": "stage12_candidate_extraction"},
    "status": {"enum": ["ok", "no_statement"]},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "provider_metadata": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}
  },
  "$defs": {
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["surface_form", "role", "entity_class"],
      "properties": {
        "surface_form": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "entity_class": {"type": "string", "minLength": 1}
      }
    },
    "quantity": {
      "type": "object", "additionalProperties": false,
      "required": ["surface_form", "unit", "operator"],
      "properties": {
        "surface_form": {"type": "string", "minLength": 1},
        "value": {"type": "number"}, "min": {"type": "number"}, "max": {"type": "number"},
        "unit": {"type": "string", "minLength": 1}, "operator": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["statement_text", "statement_type", "predicate", "subject_entities", "object_value", "value", "unit", "quantities", "normative_modality", "negation_scope", "conditions", "applicability_scope", "relation_direction"],
      "properties": {
        "statement_text": {"type": "string", "minLength": 1},
        "statement_type": {"enum": ["fact", "requirement", "procedure", "condition", "observation", "verification", "limitation"]},
        "predicate": {"enum": ["requires", "prohibits", "describes", "causes", "verifies", "limits_scope"]},
        "subject_entities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entity"}},
        "object_value": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "source_assertion"}, "value": {"type": "string", "minLength": 1}}},
        "value": {"type": ["number", "null"]}, "unit": {"type": ["string", "null"]},
        "quantities": {"type": "array", "items": {"$ref": "#/$defs/quantity"}},
        "normative_modality": {"enum": ["shall", "must", "descriptive"]},
        "negation_scope": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["surface_form", "polarity", "scope_type"], "properties": {"surface_form": {"type": "string"}, "polarity": {"type": "string"}, "scope_type": {"type": "string"}}}},
        "conditions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["surface_form", "kind"], "properties": {"surface_form": {"type": "string"}, "kind": {"const": "condition"}}}},
        "applicability_scope": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["known", "unknown"]}, "applicability_text": {"type": "string"}, "model": {"type": "string"}, "equipment": {"type": "string"}, "lifecycle_stage": {"type": "string"}, "activity": {"type": "string"}, "operating_state": {"type": "string"}, "condition": {"type": "string"}}},
        "relation_direction": {"enum": ["subject_to_object", "cause_to_effect", "condition_to_consequence", "procedure_order", "scope_to_subject"]}
      }
    }
  }
}
