{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/turbine-v2/stage12-candidate.schema.json",
  "title": "Stage 12 Engineering Statement candidate",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "artifact_kind",
    "status",
    "formal_release",
    "producer",
    "inputs",
    "extraction_profile",
    "provider_id",
    "prompt_version",
    "provider_metadata",
    "candidates",
    "review_diagnostics"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stage": {
      "const": "12"
    },
    "artifact_kind": {
      "const": "engineering_statement_candidates"
    },
    "status": {
      "const": "candidate_only"
    },
    "formal_release": {
      "const": false
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "extraction_fingerprint": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "audit_lineage_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "extraction_profile": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "provider_metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "review_diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_id": {
            "type": "string",
            "pattern": "^stage12-candidate-[a-f0-9]{20}$"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "severity": {
            "const": "needs_review"
          },
          "message": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          }
        }
      }
    },
    "evidence_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "status",
          "candidate_ids"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "ok",
              "no_statement"
            ]
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^stage12-candidate-[a-f0-9]{20}$"
            }
          },
          "no_statement_reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          }
        }
      }
    },
    "operation_group_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id",
          "status",
          "candidate_ids",
          "covered_step_indices",
          "missing_step_indices"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "complete",
              "unresolved"
            ]
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^stage12-candidate-[a-f0-9]{20}$"
            }
          },
          "covered_step_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "missing_step_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "context_group_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id",
          "status",
          "candidate_ids",
          "covered_item_indices",
          "missing_item_indices"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "complete",
              "unresolved"
            ]
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^stage12-candidate-[a-f0-9]{20}$"
            }
          },
          "covered_item_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "missing_item_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "question_group_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id",
          "status",
          "candidate_ids"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "complete",
              "unresolved"
            ]
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^stage12-candidate-[a-f0-9]{20}$"
            }
          }
        }
      }
    },
    "runtime_projection": {
      "type": "object"
    },
    "extraction_batch_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "split",
        "task",
        "statement_text",
        "statement_type",
        "predicate",
        "relation_direction",
        "subject_entities",
        "object_value",
        "value",
        "unit",
        "quantities",
        "normative_modality",
        "negation_scope",
        "conditions",
        "applicability_scope",
        "evidence_bindings",
        "source_span_ids",
        "evidence_version_id",
        "document_logical_id",
        "revision_id",
        "physical_page",
        "logical_page",
        "source_text_sha256",
        "evidence_quote",
        "review_status",
        "formal_release",
        "extraction_profile"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^stage12-candidate-[a-f0-9]{20}$"
        },
        "split": {
          "enum": [
            "development_regression_golden",
            "acceptance_holdout"
          ]
        },
        "task": {
          "const": "statement"
        },
        "provider_provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider_alias": {
              "type": "string"
            },
            "endpoint_alias": {
              "type": "string"
            },
            "generated_by": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "config_fingerprint": {
              "type": "string"
            },
            "failover_used": {
              "type": "boolean"
            },
            "fallback_from": {
              "type": "string"
            }
          }
        },
        "statement_text": {
          "type": "string",
          "minLength": 1
        },
        "statement_type": {
          "enum": [
            "fact",
            "requirement",
            "procedure",
            "condition",
            "observation",
            "verification",
            "limitation"
          ]
        },
        "predicate": {
          "enum": [
            "requires",
            "prohibits",
            "describes",
            "causes",
            "verifies",
            "limits_scope"
          ]
        },
        "procedure_group": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "group_id",
            "status"
          ],
          "properties": {
            "group_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "indexed",
                "uncertain"
              ]
            },
            "step_index": {
              "type": "integer",
              "minimum": 1
            },
            "step_total": {
              "type": "integer",
              "minimum": 1
            },
            "uncertainty_reason": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            }
          }
        },
        "source_list_item": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "group_id",
            "status"
          ],
          "properties": {
            "group_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "indexed",
                "uncertain"
              ]
            },
            "item_index": {
              "type": "integer",
              "minimum": 1
            },
            "item_total": {
              "type": "integer",
              "minimum": 1
            },
            "uncertainty_reason": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            }
          }
        },
        "source_question": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "group_id",
            "status"
          ],
          "properties": {
            "group_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "linked",
                "uncertain"
              ]
            },
            "answer_option": {
              "type": "string",
              "minLength": 1
            },
            "answer_text": {
              "type": "string",
              "minLength": 1
            },
            "uncertainty_reason": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            }
          }
        },
        "subject_entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "surface_form",
              "role",
              "entity_class"
            ],
            "additionalProperties": false,
            "properties": {
              "surface_form": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "subject",
                  "object",
                  "related",
                  "quantity_target"
                ]
              },
              "entity_class": {
                "type": "string"
              }
            }
          }
        },
        "object_value": {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "source_assertion"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "surface_form",
              "unit",
              "operator"
            ],
            "additionalProperties": false,
            "properties": {
              "surface_form": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "operator": {
                "type": "string"
              }
            }
          }
        },
        "normative_modality": {
          "enum": [
            "shall",
            "must",
            "permitted",
            "recommended",
            "descriptive"
          ]
        },
        "negation_scope": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "surface_form",
              "polarity",
              "scope_type"
            ],
            "additionalProperties": false,
            "properties": {
              "surface_form": {
                "type": "string"
              },
              "polarity": {
                "type": "string"
              },
              "scope_type": {
                "type": "string"
              }
            }
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "surface_form",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "surface_form": {
                "type": "string"
              },
              "kind": {
                "const": "condition"
              }
            }
          }
        },
        "applicability_scope": {
          "type": "object",
          "required": [
            "document_key",
            "physical_page",
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "document_key": {
              "type": "string"
            },
            "physical_page": {
              "type": "integer",
              "minimum": 1
            },
            "logical_page": {
              "type": "string"
            },
            "status": {
              "enum": [
                "known",
                "unknown"
              ]
            },
            "applicability_text": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "equipment": {
              "type": "string"
            },
            "lifecycle_stage": {
              "type": "string"
            },
            "activity": {
              "type": "string"
            },
            "operating_state": {
              "type": "string"
            },
            "condition": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "known"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "required": [
                  "applicability_text"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "unknown"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "applicability_text"
                  ]
                }
              }
            }
          ]
        },
        "relation_direction": {
          "enum": [
            "subject_to_object",
            "cause_to_effect",
            "condition_to_consequence",
            "procedure_order",
            "scope_to_subject"
          ]
        },
        "evidence_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "evidence_id",
              "support_type"
            ],
            "additionalProperties": false,
            "properties": {
              "evidence_id": {
                "type": "string"
              },
              "support_type": {
                "enum": [
                  "direct",
                  "partial",
                  "context"
                ]
              },
              "source_span_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_version_id": {
                "type": "string"
              },
              "source_text_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidence_quote": {
                "type": "string"
              },
              "physical_page": {
                "type": "integer",
                "minimum": 1
              },
              "logical_page": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "document_logical_id": {
                "type": "string"
              },
              "revision_id": {
                "type": "string"
              },
              "source_span_locations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_span_id",
                    "physical_page",
                    "logical_page"
                  ],
                  "properties": {
                    "source_span_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "physical_page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "logical_page": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "source_span_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_span_locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_span_id",
              "physical_page",
              "logical_page"
            ],
            "properties": {
              "source_span_id": {
                "type": "string",
                "minLength": 1
              },
              "physical_page": {
                "type": "integer",
                "minimum": 1
              },
              "logical_page": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "evidence_version_id": {
          "type": "string",
          "minLength": 1
        },
        "document_logical_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "physical_page": {
          "type": "integer",
          "minimum": 1
        },
        "logical_page": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_quote": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "const": "candidate_only"
        },
        "formal_release": {
          "const": false
        },
        "extraction_profile": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "procedure_group"
            ],
            "properties": {
              "procedure_group": {
                "properties": {
                  "status": {
                    "const": "indexed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "procedure_group": {
                "required": [
                  "step_index",
                  "step_total"
                ],
                "not": {
                  "required": [
                    "uncertainty_reason"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "procedure_group"
            ],
            "properties": {
              "procedure_group": {
                "properties": {
                  "status": {
                    "const": "uncertain"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "procedure_group": {
                "required": [
                  "uncertainty_reason"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "step_index"
                      ]
                    },
                    {
                      "required": [
                        "step_total"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "source_list_item"
            ],
            "properties": {
              "source_list_item": {
                "properties": {
                  "status": {
                    "const": "indexed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "source_list_item": {
                "required": [
                  "item_index",
                  "item_total"
                ],
                "not": {
                  "required": [
                    "uncertainty_reason"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "source_list_item"
            ],
            "properties": {
              "source_list_item": {
                "properties": {
                  "status": {
                    "const": "uncertain"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "source_list_item": {
                "required": [
                  "uncertainty_reason"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "item_index"
                      ]
                    },
                    {
                      "required": [
                        "item_total"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "source_question"
            ],
            "properties": {
              "source_question": {
                "properties": {
                  "status": {
                    "const": "linked"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "source_question": {
                "required": [
                  "answer_option",
                  "answer_text"
                ],
                "not": {
                  "required": [
                    "uncertainty_reason"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "source_question"
            ],
            "properties": {
              "source_question": {
                "properties": {
                  "status": {
                    "const": "uncertain"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "source_question": {
                "required": [
                  "uncertainty_reason"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "answer_option"
                      ]
                    },
                    {
                      "required": [
                        "answer_text"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "procedure_group",
                  "source_list_item"
                ]
              },
              {
                "required": [
                  "procedure_group",
                  "source_question"
                ]
              },
              {
                "required": [
                  "source_list_item",
                  "source_question"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
