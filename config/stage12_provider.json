{
  "schema_version": 1,
  "stage": "12",
  "artifact_kind": "stage12_extraction_provider_config",
  "status": "active_for_stage12",
  "default_provider": "external_llm",
  "prompt": {
    "version": "stage12-candidate-prompt-v7",
    "path": "config/stage12_prompt.txt"
  },
  "providers": {
    "fixture": {
      "kind": "deterministic_fixture",
      "enabled": true,
      "max_attempts": 1
    },
    "external_llm": {
      "kind": "external_llm",
      "enabled": true,
      "transport": "openai_compatible_chat_completions",
      "credential_env": "LLM_API_KEY",
      "endpoint_env": "LLM_BASE_URL",
      "model_env": "LLM_MODEL",
      "permission_env": "LLM_ALLOW_EVIDENCE_SEND",
      "timeout_env": "LLM_TIMEOUT_SECONDS",
      "transport_max_attempts": 3,
      "response_max_attempts": 3,
      "transient_max_attempts": 2,
      "timeout_max_attempts": 1,
      "backoff_base_seconds": 1.0,
      "max_backoff_seconds": 20.0,
      "failover_timeout_seconds": 10,
      "backup": {
        "enabled": true,
        "endpoint_env": "LLM_FALLBACK_BASE_URL",
        "model_env": "LLM_FALLBACK_MODEL",
        "credential_env": "LLM_FALLBACK_API_KEY",
        "timeout_env": "LLM_FALLBACK_TIMEOUT_SECONDS",
        "auth_level_fallback": false
      }
    }
  },
  "source_permission": {
    "authority": "data/registry/source_assets.jsonl",
    "allowed_values": ["allowed"],
    "denied_values": ["not_allowed", "local_only", "not_assessed"],
    "missing_policy": "deny"
  },
  "consumers": [
    "scripts/build_stage12_candidates.py",
    "tests/stage12"
  ]
}
