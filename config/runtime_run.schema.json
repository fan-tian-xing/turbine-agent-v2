{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/turbine-v2/extraction-batch.schema.json",
  "title": "Lightweight extraction batch record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "extraction_batch_id", "operation", "status", "input_refs", "output_ref", "output_fingerprint"],
  "properties": {
    "schema_version": {"const": 1},
    "extraction_batch_id": {"type": "string", "pattern": "^batch-[A-Za-z0-9_-]+$"},
    "operation": {"type": "string", "enum": ["terminology_extraction", "statement_extraction", "evidence_build"]},
    "status": {"const": "completed"},
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind"],
        "additionalProperties": true,
        "properties": {"kind": {"type": "string"}}
      }
    },
    "output_ref": {"type": "object", "required": ["path", "kind"], "additionalProperties": true, "properties": {"path": {"type": "string"}, "kind": {"type": "string"}}},
    "output_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
